  "authors": [
    "xyannwalk",
    "selfdot"
  ],
  "license": "Apache 2.0 with Commons Clause",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.selfdot.cobblemontrainers.fabric.CobblemonTrainersFabric"
    ],
    "server": [
      "com.selfdot.cobblemontrainers.fabric.server.CobblemonTrainersFabricServer"
    ]
  },
  "mixins": [
    "cobblemontrainersex.mixins.json",
    "cobblemontrainersex-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": ">=1.20.1",
    "architectury": ">=9.2.14",
    "cobblemon": ">=1.5.2"
  }
